    "delete": {
      "method": "DELETE",
      "path": "/api/ingredients/:id",
      "headers": { "Authorization": "Bearer <token>" },
      "params": { "id": "string (uuid)" },
      "exampleResponse": { "success": true, "data": { "deleted": true } }
    },
    "search": {
      "method": "GET",
      "path": "/api/ingredients/search",
      "headers": { "Authorization": "Bearer <token>" },
      "query": { "q": "string (min 2)", "limit": "number (opcional, default 10)" },
      "exampleResponse": {
        "success": true,
        "data": [{ "id": "uuid", "name": "Arroz", "caloriesPer100g": 130 }]
      }
    },
    "calculateCalories": {
      "method": "POST",
      "path": "/api/ingredients/calculate-calories",
      "headers": { "Authorization": "Bearer <token>" },
      "body": { "ingredientId": "string (uuid)", "amount": "number (gramos)" },
      "exampleRequest": { "ingredientId": "uuid", "amount": 150 },
      "exampleResponse": {
        "success": true,
        "data": {
          "ingredientId": "uuid",
          "ingredientName": "Arroz",
          "amount": 150,
          "caloriesPer100g": 130,
          "calculatedCalories": 195
        }
      }
    },
    "calculateBulkCalories": {
      "method": "POST",
      "path": "/api/ingredients/calculate-bulk-calories",
      "headers": { "Authorization": "Bearer <token>" },
      "body": {
        "ingredients": [{ "ingredientId": "string (uuid)", "amount": "number" }]
      },
      "exampleRequest": {
        "ingredients": [
          { "ingredientId": "uuid1", "amount": 100 },
          { "ingredientId": "uuid2", "amount": 50 }
        ]
      },
      "exampleResponse": {
        "success": true,
        "data": {
          "ingredients": [
            {
              "ingredientId": "uuid1",
              "ingredientName": "Arroz",
              "amount": 100,
              "caloriesPer100g": 130,
              "calculatedCalories": 130
            }
          ],
          "totalCalories": 130
        }
      }
    }
  },

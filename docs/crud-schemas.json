      "body": {
        "name": "string (opcional, min 2)",
        "caloriesPer100g": "number (opcional, >= 0)"
      },
      "exampleRequest": { "name": "Arroz integral", "caloriesPer100g": 112 },
      "exampleResponse": {
        "success": true,
        "data": { "id": "uuid", "name": "Arroz integral", "caloriesPer100g": 112, "createdAt": "ISO8601" }

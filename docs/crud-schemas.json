          "name": "Arroz",
          "caloriesPer100g": 130,
          "createdBy": "uuid",
          "createdAt": "ISO8601"
        }
      }
    },
    "update": {
      "method": "PUT",
      "path": "/api/ingredients/:id",
      "headers": { "Authorization": "Bearer <token>" },

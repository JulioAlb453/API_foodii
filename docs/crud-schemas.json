          "image": null
        }
      }
    }
  },
  "ingredients": {
    "create": {
      "method": "POST",
      "path": "/api/ingredients",
      "headers": { "Authorization": "Bearer <token>" },
      "body": {
        "name": "string (min 2)",
        "caloriesPer100g": "number (>= 0)"
      },
      "exampleRequest": { "name": "Arroz", "caloriesPer100g": 130 },

              }
            ]
          }
        ]
      }
    },
    "random": {
      "method": "GET",
      "path": "/api/meals/random",
      "headers": { "Authorization": "Bearer <token>" },
      "exampleResponse": {
        "success": true,
        "data": {
          "id": "m1",

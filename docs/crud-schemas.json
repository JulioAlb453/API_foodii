{
  "_documentation": {
    "auth": "En rutas protegidas enviar el header: Authorization: Bearer <JWT>. El payload del JWT incluye id y username del usuario.",
    "responseShape": "Los módulos auth, meals e ingredients responden normalmente con { \"success\": true, \"data\": ... } o { \"success\": false, \"error\": \"mensaje\" }. El módulo dishes devuelve el cuerpo JSON directamente (objeto o array), sin envoltorio success/data.",
    "multipartMeals": "POST /api/meals y PUT /api/meals/:id usan multer: Content-Type multipart/form-data. Campos típicos: userId, name, date, mealTime, ingredients (string JSON), steps (string JSON, opcional), image (archivo, opcional). Sin imagen se puede usar application/json.",
    "multipartDishes": "POST /api/dishes y PUT /api/dishes/:id: multipart con name, description (opcional), calories (string numérico) e image (archivo, opcional)."
  },
  "auth": {
    "register": {
      "method": "POST",
      "path": "/api/auth/register",
      "body": {
        "username": "string (min 3)",
        "password": "string (min 6)"
      },
      "exampleRequest": { "username": "maria", "password": "123456" },
      "exampleResponse": {
        "success": true,
        "message": "Usuario registrado exitosamente",
        "data": {
          "user": { "id": "uuid", "username": "maria", "createdAt": "ISO8601" },
          "token": "jwt...",
          "tokenExpiresIn": "7d"
        }
      }
    },
    "login": {
      "method": "POST",
      "path": "/api/auth/login",
      "body": {
        "username": "string",
        "password": "string"
      },
      "exampleRequest": { "username": "maria", "password": "123456" },
      "exampleResponse": {
        "success": true,
        "message": "Login exitoso",
        "data": {
          "user": { "id": "uuid", "username": "maria", "createdAt": "ISO8601" },
          "token": "jwt...",
          "tokenExpiresIn": "7d"
        }
      }
    },
    "verifyTokenBody": {
      "method": "POST",
      "path": "/api/auth/verify-token",
      "body": { "token": "string" },
      "exampleRequest": { "token": "eyJhbGc..." },
      "exampleResponse": {
        "success": true,
        "message": "Token válido",
        "data": { "isValid": true, "user": { "id": "uuid", "username": "..." } }
      }
    },
    "verifyTokenBearer": {
      "method": "GET",
      "path": "/api/auth/verify-token",
      "headers": { "Authorization": "Bearer <token>" },
      "exampleResponse": {
        "success": true,
        "message": "Token válido",
        "data": { "isValid": true, "user": { "id": "uuid", "username": "..." } }
      }
    },
    "health": {
      "method": "GET",
      "path": "/api/auth/health",
      "query": {},
      "exampleResponse": {
        "success": true,
        "data": { "service": "authentication", "status": "operational" }
      }
    },
    "getProfile": {
      "method": "GET",
      "path": "/api/auth/profile",
      "headers": { "Authorization": "Bearer <token>" },
      "exampleResponse": {
        "success": true,
        "data": { "id": "uuid", "username": "maria", "createdAt": "ISO8601" }
      }
    },
    "updateProfile": {
      "method": "PUT",
      "path": "/api/auth/profile",
      "headers": { "Authorization": "Bearer <token>" },
      "body": { "username": "string (min 3)" },
      "exampleRequest": { "username": "maria_nueva" },
      "exampleResponse": {
        "success": true,
        "message": "Perfil actualizado exitosamente",
        "data": { "id": "uuid", "username": "maria_nueva", "createdAt": "ISO8601" }
      }
    },
    "deleteAccount": {
      "method": "DELETE",
      "path": "/api/auth/account",
      "headers": { "Authorization": "Bearer <token>" },
      "body": { "password": "string" },
      "exampleRequest": { "password": "123456" },
      "exampleResponse": { "success": true, "message": "Cuenta eliminada exitosamente" }
    },
    "logout": {
      "method": "POST",
      "path": "/api/auth/logout",
      "headers": { "Authorization": "Bearer <token>" },
      "exampleResponse": { "success": true, "message": "Logout exitoso" }
    }
  },
  "users": {
    "patchPreferences": {
      "method": "PATCH",
      "path": "/api/users/preferences",
      "headers": { "Authorization": "Bearer <token>" },
      "body": {
        "notificationCategoryPreferences": "string[] (etiquetas exactas de la app o slugs) | null",
        "fcmToken": "opcional: string | null (null borra el token en BD)"
      },
      "exampleRequest": {
        "notificationCategoryPreferences": ["Alto en proteína", "Meal prep"],
        "fcmToken": "fcm-device-token-opcional"
      },
      "exampleResponse": {
        "success": true,
        "message": "Preferencias de notificación actualizadas",
        "data": {
          "id": "uuid",
          "notificationCategoryPreferences": ["high_protein", "meal_prep"],
          "fcmTokenUpdated": true
        }
      },
      "notes": "En BD se guardan slugs (ej. fitness, high_protein, meal_prep). La app debe suscribirse a FirebaseMessaging con esos mismos nombres tras un PATCH exitoso. Catálogo orientado a agendación de comidas: ver notificationCategorySlug.ts."
    }
  },
  "admin": {
    "pushTopic": {
      "method": "POST",
      "path": "/api/admin/push/topic",
      "headers": { "X-Admin-Secret": "valor de ADMIN_PUSH_SECRET en el servidor" },
      "body": {
        "topicSlug": "string (ej. high_protein, meal_prep)",
        "title": "string",
        "body": "string",
        "data": "opcional: objeto; valores convertidos a string (ej. { \"mealId\": \"uuid\", \"type\": \"NEW_MEAL\" })"
      },
      "exampleRequest": {
        "topicSlug": "high_protein",
        "title": "Nueva sugerencia",
        "body": "Hay nuevas ideas altas en proteína en Foodii",
        "data": { "mealId": "uuid-de-la-comida", "type": "NEW_MEAL" }
      },
      "exampleResponse": {
        "success": true,
        "message": "Notificación enviada al tópico",
        "data": { "messageId": "projects/.../messages/...", "topicSlug": "high_protein" }
      }
    }
  },
  "meals": {
    "create": {
      "method": "POST",
      "path": "/api/meals",
      "headers": { "Authorization": "Bearer <token>" },
      "contentType": "application/json | multipart/form-data",
      "bodyJson": {
        "userId": "string (uuid)",
        "name": "string (min 2)",
        "date": "string (YYYY-MM-DD)",
        "mealTime": "breakfast | lunch | dinner | snack",
        "ingredients": [{ "ingredientId": "string (uuid)", "amount": "number (gramos)" }],
        "steps": "opcional: string[] o { description: string }[]; máx. 50 pasos; orden = orden de la lista"
      },
      "multipartFields": {
        "userId": "string",
        "name": "string",
        "date": "string",
        "mealTime": "string",
        "ingredients": "string (JSON array)",
        "steps": "string (JSON array, opcional)",
        "image": "archivo (opcional)"
      },
      "exampleRequest": {
        "userId": "user-uuid",
        "name": "Desayuno Fit",
        "date": "2026-04-10",
        "mealTime": "breakfast",
        "ingredients": [{ "ingredientId": "ing-uuid", "amount": 150 }],
        "steps": ["Batir huevos", "Cocinar en sartén antiadherente"]
      },
      "exampleResponse": {
        "success": true,
        "data": {
          "id": "m1",
          "name": "Desayuno Fit",
          "date": "2026-04-10T00:00:00.000Z",
          "mealTime": "breakfast",
          "ingredients": [
            {
              "ingredientId": "i4",
              "amount": 150,
              "ingredientName": "Huevo",
              "calories": 232.5
            }
          ],
          "steps": [
            { "stepOrder": 1, "description": "Batir huevos" },
            { "stepOrder": 2, "description": "Cocinar en sartén antiadherente" }
          ],
          "totalCalories": 232.5,
          "createdAt": "2026-04-10T16:22:30.180Z",
          "image": "/uploads/foto.jpg"
        }
      }
    },
    "getAll": {
      "method": "GET",
      "path": "/api/meals",
      "headers": { "Authorization": "Bearer <token>" },
      "query": { "date": "string (opcional, YYYY-MM-DD)" },
      "exampleResponse": {
        "success": true,
        "data": [
          {
            "id": "m1",
            "name": "Desayuno Fit",
            "date": "2026-04-10T00:00:00.000Z",
            "mealTime": "breakfast",
            "ingredients": [
              {
                "ingredientId": "i4",
                "amount": 100,
                "ingredientName": "Huevo",
                "calories": 155
              }
            ],
            "steps": [{ "stepOrder": 1, "description": "..." }],
            "totalCalories": 155,
            "createdAt": "2026-04-10T16:22:30.180Z",
            "image": null
          }
        ]
      }
    },
    "getById": {
      "method": "GET",
      "path": "/api/meals/:id",
      "headers": { "Authorization": "Bearer <token>" },
      "params": { "id": "string (uuid)" },
      "exampleResponse": {
        "success": true,
        "data": {
          "id": "m1",
          "name": "Desayuno Fit",
          "date": "2026-04-10T00:00:00.000Z",
          "mealTime": "breakfast",
          "ingredients": [
            {
              "ingredientId": "i4",
              "amount": 100,
              "ingredientName": "Huevo",
              "calories": 155
            }
          ],
          "steps": [{ "stepOrder": 1, "description": "Batir huevos" }],
          "totalCalories": 155,
          "createdAt": "2026-04-10T16:22:30.180Z",
          "image": null
        }
      }
    },
    "update": {
      "method": "PUT",
      "path": "/api/meals/:id",
      "headers": { "Authorization": "Bearer <token>" },
      "params": { "id": "string (uuid)" },
      "body": {
        "userId": "string (uuid)",
        "name": "string (opcional)",
        "date": "string (opcional, YYYY-MM-DD)",
        "mealTime": "string (opcional)",
        "ingredients": "array (opcional)",
        "steps": "opcional: si la clave está presente, reemplaza todos los pasos; [] elimina pasos; si se omite la clave, se conservan los pasos actuales"
      },
      "exampleRequest": {
        "userId": "user-uuid",
        "name": "Almuerzo Proteico",
        "date": "2026-04-10",
        "mealTime": "lunch",
        "ingredients": [{ "ingredientId": "uuid", "amount": 200 }],
        "steps": ["Cocinar pollo", "Servir con arroz"]
      },
      "exampleResponse": {
        "success": true,
        "data": {
          "id": "m2",
          "name": "Almuerzo Proteico",
          "date": "2026-04-10T00:00:00.000Z",
          "mealTime": "lunch",
          "ingredients": [
            {
              "ingredientId": "i1",
              "amount": 200,
              "ingredientName": "Pechuga de Pollo",
              "calories": 330
            }
          ],
          "steps": [
            { "stepOrder": 1, "description": "Cocinar pollo" },
            { "stepOrder": 2, "description": "Servir con arroz" }
          ],
          "totalCalories": 330,
          "createdAt": "2026-04-10T16:22:30.180Z",
          "image": null
        }
      }
    },
    "delete": {
      "method": "DELETE",
      "path": "/api/meals/:id",
      "headers": { "Authorization": "Bearer <token>" },
      "params": { "id": "string (uuid)" },
      "body": { "userId": "string (uuid)" },
      "exampleRequest": { "userId": "user-uuid" },
      "exampleResponse": { "success": true, "data": { "deleted": true } }
    },
    "caloriesSummary": {
      "method": "GET",
      "path": "/api/meals/calories-summary",
      "headers": { "Authorization": "Bearer <token>" },
      "query": { "date": "string (YYYY-MM-DD, opcional)" },
      "exampleResponse": {
        "success": true,
        "data": {
          "totalCalories": 1050,
